# Defense in depth — explicitly deny direct access to sensitive files even if
# the rewrite below is disabled for some reason (e.g. mod_rewrite unavailable).
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|artisan|webpack\.mix\.js|phpunit\.xml|phpstan\.neon(\.dist)?|README\.md|load_font\.php|_ide_helper.*\.php)$">
    Require all denied
</FilesMatch>

# Forward all top-level requests into Laravel's public/ directory so the app
# can serve from a host where DocumentRoot points at the project root.
# The condition prevents /public/... requests from being rewritten to /public/public/...
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
